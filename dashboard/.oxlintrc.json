{
  "plugins": ["react", "typescript"],
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "react/no-direct-mutation-state": "error",
    "complexity": ["error", { "max": 6 }],
    "max-lines-per-function": ["error", { "max": 40 }]
  },
  "ignorePatterns": ["src/components/ui/**"]
}
