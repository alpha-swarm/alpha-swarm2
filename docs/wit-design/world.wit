package alpha-swarm:world@0.1.0;

/// World for the agent worker component.
/// Imports the generic inference interface — never a specific backend.
world agent-worker {
    import alpha-swarm:inference/completions@0.1.0;
    import alpha-swarm:virtfs/repository@0.1.0;
    import alpha-swarm:quality/gate@0.1.0;
    import alpha-swarm:knowledge/base@0.1.0;
    import alpha-swarm:events/bus@0.1.0;

    import wasi:logging/logging@0.1.0;
    import wasi:clocks/wall-clock@0.2.0;

    /// The agent receives a task and processes it.
    export handler: interface {
        use alpha-swarm:types/types.{task, task-result, swarm-error};

        /// Execute a one-shot task. Agent claims it, runs inference,
        /// applies changes, validates, and reports results.
        handle-task: func(task: task) -> result<task-result, swarm-error>;
    };
}

/// World for the orchestrator component.
/// Uses inference/completions for task decomposition.
world orchestrator {
    import alpha-swarm:inference/completions@0.1.0;
    import alpha-swarm:virtfs/repository@0.1.0;
    import alpha-swarm:quality/gate@0.1.0;
    import alpha-swarm:knowledge/base@0.1.0;
    import alpha-swarm:project/manager@0.1.0;
    import alpha-swarm:events/bus@0.1.0;

    import wasi:logging/logging@0.1.0;
    import wasi:clocks/wall-clock@0.2.0;

    /// The orchestrator accepts a high-level goal and manages sub-tasks.
    export planner: interface {
        use alpha-swarm:types/types.{project-id, task, task-result, swarm-error};

        /// Decompose a high-level goal into sub-tasks for a project.
        plan: func(
            project: project-id,
            goal: string,
        ) -> result<list<task>, swarm-error>;

        /// Merge completed task results back into the project's repo.
        merge-results: func(
            project: project-id,
            results: list<task-result>,
        ) -> result<_, swarm-error>;
    };
}

/// World for the gateway component.
/// Exposes the high-level control API to external clients.
world gateway {
    import alpha-swarm:project/manager@0.1.0;
    import alpha-swarm:swarm/control@0.1.0;
    import alpha-swarm:events/bus@0.1.0;
    import alpha-swarm:inference/completions@0.1.0;

    import wasi:logging/logging@0.1.0;
    import wasi:clocks/wall-clock@0.2.0;
}

/// World for the inference router component.
/// Imports all backends, exports the generic completions interface.
/// Routes requests to the best available backend + model.
world inference-router {
    import alpha-swarm:inference/backend@0.1.0;
    import alpha-swarm:ollama/provider@0.1.0;
    import alpha-swarm:claude/provider@0.1.0;
    import alpha-swarm:events/bus@0.1.0;

    import wasi:logging/logging@0.1.0;
    import wasi:clocks/wall-clock@0.2.0;

    export alpha-swarm:inference/completions@0.1.0;
}
