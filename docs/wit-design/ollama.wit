package alpha-swarm:ollama@0.1.0;

/// Ollama-specific inference backend.
/// Implements alpha-swarm:inference/backend for local Ollama instances.
/// Also exposes Ollama-specific operations (pull, running models, etc.).
interface provider {
    use alpha-swarm:inference/types.{model-info, backend-kind};
    use alpha-swarm:types/types.{swarm-error};

    /// Pull a model from the Ollama registry.
    pull-model: func(name: string) -> result<model-info, swarm-error>;

    /// List models currently loaded in VRAM/RAM.
    running-models: func() -> result<list<model-info>, swarm-error>;

    /// Unload a model from memory.
    unload-model: func(name: string) -> result<_, swarm-error>;
}
