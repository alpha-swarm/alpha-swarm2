<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.alphaswarm.wash-host</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/wash</string>
        <string>host</string>
        <string>--scheduler-nats-url</string>
        <string>nats://127.0.0.1:4222</string>
        <string>--data-nats-url</string>
        <string>nats://127.0.0.1:4222</string>
        <string>--host-name</string>
        <string>alpha-swarm-csatapaci</string>
        <string>--host-group</string>
        <string>alpha-swarm</string>
        <string>--non-interactive</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/markkovari/Library/Logs/alpha-swarm/wash-host.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/markkovari/Library/Logs/alpha-swarm/wash-host.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/local/bin</string>
    </dict>
</dict>
</plist>
