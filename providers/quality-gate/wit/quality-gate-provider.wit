package alpha-swarm:quality-gate-provider@0.1.0;

interface types {
    type agent-id = string;
    type repo-id = string;

    variant swarm-error {
        not-found(string),
        already-claimed(string),
        inference-failed(string),
        quality-gate-failed(string),
        io-error(string),
        internal(string),
    }
}

interface gate {
    use types.{repo-id, agent-id, swarm-error};

    record check-result {
        check-name: string,
        passed: bool,
        stdout: string,
        stderr: string,
        exit-code: s32,
        duration-ms: u64,
    }

    check-all: func(repo: repo-id, agent: agent-id) -> result<list<check-result>, swarm-error>;
}

world quality-gate-provider {
    export gate;
}
