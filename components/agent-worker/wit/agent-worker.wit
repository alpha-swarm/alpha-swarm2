package alpha-swarm:agent-worker@0.1.0;

/// The agent worker world for wasmCloud 2.0.
/// Uses standard WASI interfaces provided by the host.
/// Calls Ollama via wasi:http/outgoing-handler.
/// Handles tasks via wasmcloud:messaging for triggering.

world agent-worker {
    /// HTTP client for calling Ollama API
    import wasi:http/outgoing-handler@0.2.0;
    import wasi:http/types@0.2.0;

    /// Clock for timing
    import wasi:clocks/wall-clock@0.2.0;
    import wasi:clocks/monotonic-clock@0.2.0;

    /// IO primitives
    import wasi:io/streams@0.2.0;
    import wasi:io/poll@0.2.0;
    import wasi:io/error@0.2.0;

    /// Handle incoming HTTP requests (for task submission)
    export wasi:http/incoming-handler@0.2.0;
}
