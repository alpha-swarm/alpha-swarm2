package alpha-swarm:tool-web@0.1.0;

/// Tool worker for web operations: search, URL fetch, crates.io.
/// Sandboxed: outgoing HTTP only, no filesystem access.

world tool-web {
    /// HTTP client for outgoing requests (search APIs, URL fetch)
    import wasi:http/outgoing-handler@0.2.0;
    import wasi:http/types@0.2.0;

    /// Clock for timing
    import wasi:clocks/wall-clock@0.2.0;
    import wasi:clocks/monotonic-clock@0.2.0;

    /// IO primitives
    import wasi:io/streams@0.2.0;
    import wasi:io/poll@0.2.0;
    import wasi:io/error@0.2.0;

    /// Handle incoming HTTP requests (tool call dispatch)
    export wasi:http/incoming-handler@0.2.0;
}
